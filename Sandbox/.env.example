# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LM Studio Configuration (for local LLM hosting)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_API_KEY=not-needed-for-local

# Default LLM Models
DEFAULT_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
FALLBACK_OPENROUTER_MODEL=microsoft/phi-3-mini-128k-instruct:free
DEFAULT_LM_STUDIO_MODEL=local-model

# Framework Configuration
LOG_LEVEL=INFO
MAX_RETRIES=3
REQUEST_TIMEOUT=30
RATE_LIMIT_DELAY=1.0

# State Management
STATE_BACKEND=json  # Options: json, sqlite
STATE_DIRECTORY=./simulations
ENABLE_STATE_CHECKPOINTS=true

# Development Settings
DEBUG_MODE=false
ENABLE_METRICS=true
SIMULATION_TIMEOUT=300  # seconds
